                 <string notr="true">QComboBox {
    border: 1px solid #d5d5d5;  /* Зовнішня рамка */
    background: #f5f5f5;        /* Колір фону */
    padding: 1px 18px 1px 3px; /* Зовнішні відступи */
    border-radius: 3px;        /* Радіус скруглення кутів */
    min-width: 6em;            /* Мінімальна ширина */
}

QComboBox:editable {
    background: white;         /* Колір фону в режимі редагування */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;               /* Ширина кнопки випадаючого списку */
    border-left: 1px solid #d5d5d5;  /* Ліва грань кнопки */
}

QComboBox::down-arrow {
	
	width: 13px;

   image: url(:/MainWindow/arrow-down.png);  /* Зображення стрілки вниз */
}


